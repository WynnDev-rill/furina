function renderSettings(){if(!settingsData)return;const h=settingsData.hub||{},c=settingsData.core||{},presets=settingsData.presets||{},names={adaptive:'Natural',tsundere:'Tsundere',gentle:'Lembut & perhatian',playful:'Ceria & jahil',cool:'Dingin & tenang',custom:'Kustom'};document.getElementById('assistantName').value=h.assistant_name||c.persona_name||'Furina';document.getElementById('nickname').value=h.user_nickname||c.user_nickname||'';const sel=document.getElementById('baseStyle');sel.innerHTML=Object.entries(presets).map(([k,v])=>`<option value="${esc(k)}" ${h.base_style===k?'selected':''}>${esc(names[k]||v.label||k)}</option>`).join('');document.getElementById('presetGrid').innerHTML=Object.entries(presets).map(([k,v])=>`<button class="${h.base_style===k?'on':''}" onclick="choosePreset('${k}')"><strong>${esc(names[k]||v.label||k)}</strong></button>`).join('');document.getElementById('presetDesc').textContent=(presets[h.base_style]||{}).description||'';document.getElementById('customInstructions').value=h.custom_instructions||'';document.getElementById('traits').innerHTML=Object.entries(settingsData.trait_labels||{}).map(([k,label])=>`<div class="field"><label>${esc(label)}</label><div class="range"><input id="trait-${k}" type="range" min="0" max="100" value="${Number((h.characteristics||{})[k]??50)}"><span id="traitv-${k}">${Number((h.characteristics||{})[k]??50)}</span></div></div>`).join('');Object.keys(settingsData.trait_labels||{}).forEach(k=>document.getElementById('trait-'+k).oninput=e=>document.getElementById('traitv-'+k).textContent=e.target.value);document.getElementById('threads').value=c.threads||4;document.getElementById('contextSize').value=c.context_size||4096;document.getElementById('maxTokens').value=c.max_tokens||1024}
function choosePreset(k){document.getElementById('baseStyle').value=k;presetChanged();document.querySelectorAll('#presetGrid button').forEach((b,i)=>b.classList.toggle('on',Object.keys(settingsData.presets||{})[i]===k))}
function presetChanged(){if(!settingsData)return;const k=document.getElementById('baseStyle').value,p=settingsData.presets?.[k];if(p){document.getElementById('presetDesc').textContent=p.description||'';if(p.traits){Object.entries(p.traits).forEach(([t,v])=>{const e=document.getElementById('trait-'+t);if(e){e.value=v;document.getElementById('traitv-'+t).textContent=v}})}}}
async function savePersonalization(){const traits={};Object.keys(settingsData?.trait_labels||{}).forEach(k=>traits[k]=Number(document.getElementById('trait-'+k).value));try{settingsData=await core('POST','/api/settings',{hub:{assistant_name:document.getElementById('assistantName').value,user_nickname:document.getElementById('nickname').value,base_style:document.getElementById('baseStyle').value,characteristics:traits,custom_instructions:document.getElementById('customInstructions').value}});renderSettings();renderModels();toast('Personalisasi disimpan.')}catch(e){toast(e.message)}}
async function refreshSharedSettings(){try{settingsData=await core('GET','/api/settings');renderSettings();renderModels();renderAgent();document.getElementById('brand').textContent=settingsData.hub?.assistant_name||'FurinaHub'}catch(e){toast(e.message)}}
function renderAgent(){if(!settingsData)return;const h=settingsData.hub||{},skills=h.agent_skills||{},device=systemData?.device||{},requested=device.requested_mode||h.device_control_mode||'normal',effective=device.effective_mode||'normal';document.getElementById('modeSeg').innerHTML=['normal','shizuku','root'].map(x=>`<button class="${requested===x?'on':''}" onclick="setDeviceMode('${x}')">${{normal:'Biasa',shizuku:'Shizuku',root:'Root'}[x]}</button>`).join('');const current=device[requested]||{};document.getElementById('modeNote').textContent=requested===effective?`Mode efektif: ${{normal:'Biasa',shizuku:'Shizuku',root:'Root'}[effective]}.`:`Mode diminta: ${{normal:'Biasa',shizuku:'Shizuku',root:'Root'}[requested]}, tetapi efektif masih Biasa sampai akses terverifikasi.`;document.getElementById('deviceStatus').innerHTML=`<div class="row"><div class="rowmain"><div class="rowtitle">Kesiapan ${esc(requested)}</div><div class="rowdesc">${esc(current.detail||current.hint||'Periksa akses perangkat.')}</div></div><span class="badge ${current.verified?'ok':current.available?'warn':''}">${current.verified?'Terverifikasi':current.available?'Belum dites':'Belum tersedia'}</span></div>`;document.getElementById('probeModeBtn').textContent=requested==='normal'?'Periksa Bridge & Accessibility':`Periksa akses ${requested==='shizuku'?'Shizuku':'Root'}`;const skillMeta=Object.entries(settingsData.skill_meta||{}),extraKeys=new Set(['app_launcher','quick_navigation','semantic_tap','smart_scroll','focused_typing','local_reminders','screen_reader','app_finder','form_fill','workflow_macros']);const skillRow=([k,v])=>`<div class="row"><div class="rowmain"><div class="rowtitle">${esc(v.label)}</div><div class="rowdesc">${esc(v.description)}</div></div><label class="switch"><input type="checkbox" ${skills[k]?'checked':''} onchange="toggleSkill('${k}',this.checked)"><span></span></label></div>`;const baseSkills=skillMeta.filter(([k])=>!extraKeys.has(k)),extraSkills=skillMeta.filter(([k])=>extraKeys.has(k));document.getElementById('skills').innerHTML=baseSkills.map(skillRow).join('')+(extraSkills.length?`<details class="skillDetails"><summary>Skill tambahan (${extraSkills.length})</summary>${extraSkills.map(skillRow).join('')}</details>`:'');const connector=h.connectors||{},writeToggle=document.getElementById('connectorWrite');if(writeToggle)writeToggle.checked=!!connector.allow_write_actions}
async function setDeviceMode(mode){try{settingsData=await core('POST','/api/settings',{hub:{device_control_mode:mode},core:{device_control_mode:mode}});await loadSystem();toast('Mode dipilih. Periksa akses untuk mengaktifkannya.')}catch(e){toast(e.message)}}
async function probeDeviceMode(){const mode=settingsData?.hub?.device_control_mode||'normal';toast('Memeriksa akses…');try{systemData=await core('POST','/api/device/probe',{mode});settingsData=await core('GET','/api/settings');renderAgent();toast(systemData.device?.[mode]?.verified?'Akses terverifikasi.':'Akses belum siap.')}catch(e){toast(e.message)}}
async function toggleSkill(k,on){const skills={...(settingsData.hub.agent_skills||{})};skills[k]=on;try{settingsData=await core('POST','/api/settings',{hub:{agent_skills:skills}});renderAgent()}catch(e){toast(e.message)}}
async function loadSystem(){try{systemData=await core('GET','/api/system');renderSystem()}catch(e){toast(e.message)}}
let unifiedCoreUpdate=null,unifiedUpdateSyncBusy=false;
function updateStateLabel(s){if(!s)return'Belum diperiksa.';if(s.state==='error')return s.message||'Pembaruan gagal.';if(s.state==='done'){if(s.result==='updated')return s.message||'Pembaruan berhasil.';return s.message||'Tidak ada pembaruan terbaru.'}return s.message||'Sedang memeriksa pembaruan…'}
function renderSystem(){if(!systemData)return;const status=document.getElementById('coreUpdateStatus');if(!unifiedCoreUpdate)status.textContent=`Core ${systemData.core_version||'?'} · dependency ${systemData.dependency_revision||'?'}`;renderAgent();if(connection.connected)syncUnifiedUpdateStatus(true)}
async function syncUnifiedUpdateStatus(silent=false){if(!connection.connected||unifiedUpdateSyncBusy)return unifiedCoreUpdate;unifiedUpdateSyncBusy=true;try{const s=await core('GET','/api/update/status');unifiedCoreUpdate=s;paintCoreUpdate(s);return s}catch(e){if(!silent)toast('Status update: '+e.message);return unifiedCoreUpdate}finally{unifiedUpdateSyncBusy=false}}
async function updateCore(){if(connection.connected){try{const r=await core('POST','/api/update/core',{});unifiedCoreUpdate=r;paintCoreUpdate(r);pollCoreUpdate();return}catch(e){toast(e.message)}}if(NATIVE?.startCoreUpdate){NATIVE.startCoreUpdate();refreshNativeCoreUpdate();return}toast('Termux belum dapat menjalankan updater.')}
function refreshNativeCoreUpdate(){if(connection.connected){syncUnifiedUpdateStatus(true);return}if(!NATIVE?.coreUpdateStatus)return;const el=document.getElementById('coreUpdateStatus'),btn=document.getElementById('coreUpdateBtn');const msg=NATIVE.coreUpdateStatus();if(msg)el.textContent=msg;const busy=!!NATIVE.coreUpdateBusy();btn.disabled=busy||!connection.termux_installed;btn.textContent=busy?'Memperbarui Core…':'Perbaiki / update Core & dependency';if(busy)setTimeout(refreshNativeCoreUpdate,650)}
function paintCoreUpdate(s){if(!s)return;unifiedCoreUpdate=s;const p=Math.max(0,Math.min(100,Number(s.percent||0))),bar=document.getElementById('coreUpdateProgress'),label=document.getElementById('coreUpdatePercent'),stage=document.getElementById('coreUpdateStage'),status=document.getElementById('coreUpdateStatus'),btn=document.getElementById('coreUpdateBtn'),running=['starting','running'].includes(s.state);status.textContent=updateStateLabel(s);status.style.color=s.state==='error'?'#ff718d':'';bar.classList.toggle('hidden',!['starting','running','done','error'].includes(s.state));bar.querySelector('span').style.width=p+'%';label.textContent=p+'%';const stageMap={checking:'Memeriksa',waiting:'Menunggu',foundation:'Menyiapkan fondasi',download:'Mengambil pembaruan',apply:'Menerapkan',validation:'Memvalidasi',commit:'Menyimpan',done:s.result==='updated'?'Berhasil diperbarui':'Sudah terbaru'};stage.textContent=s.state==='error'?'Gagal · '+(s.stage||'update'):(stageMap[s.stage]||({starting:'Menyiapkan',running:'Sedang berjalan',done:'Selesai'}[s.state]||'Siap diperiksa'));btn.disabled=running}
async function pollCoreUpdate(){for(let i=0;i<1500;i++){await new Promise(r=>setTimeout(r,800));try{const s=await core('GET','/api/update/status');paintCoreUpdate(s);if(['done','error'].includes(s.state)){document.getElementById('coreUpdateBtn').disabled=false;return s}}catch(e){return null}}return null}
async function checkAllUpdates(){const btn=document.getElementById('allUpdateBtn');if(btn.disabled)return;btn.disabled=true;btn.textContent='Memeriksa pembaruan…';let coreState=null;try{if(connection.termux_installed){if(connection.connected){try{coreState=await core('POST','/api/update/core',{});paintCoreUpdate(coreState);if(!['done','error'].includes(coreState.state))coreState=await pollCoreUpdate()}catch(e){coreState={state:'error',stage:'core',percent:0,message:'Pembaruan gagal pada tahap Core: '+e.message};paintCoreUpdate(coreState)}}else if(NATIVE?.startCoreUpdate){NATIVE.startCoreUpdate();for(let i=0;i<1500&&NATIVE.coreUpdateBusy();i++){refreshNativeCoreUpdate();await new Promise(r=>setTimeout(r,800))}refreshNativeCoreUpdate()}}if(NATIVE){NATIVE.checkAppUpdate();refreshAppUpdate();for(let i=0;i<240&&NATIVE.appUpdateBusy();i++)await new Promise(r=>setTimeout(r,500));refreshAppUpdate()}if(connection.connected)await syncUnifiedUpdateStatus(true)}finally{btn.disabled=false;btn.textContent='Periksa pembaruan'}}
function nativeAppUpdate(){if(!NATIVE)return;NATIVE.checkAppUpdate();refreshAppUpdate()}function refreshAppUpdate(){if(!NATIVE)return;const el=document.getElementById('apkUpdateStatus');el.textContent=NATIVE.appUpdateStatus();if(NATIVE.appUpdateBusy())setTimeout(refreshAppUpdate,600)}
function init(){initTheme();if(NATIVE){try{connection=JSON.parse(NATIVE.connectionStatus())}catch(e){}}applyConnection();refreshAppUpdate();if(connection.connected)syncUnifiedUpdateStatus(true);else refreshNativeCoreUpdate();document.addEventListener('visibilitychange',()=>{if(!document.hidden){if(connection.connected){syncUnifiedUpdateStatus(true);refreshSharedSettings()}else refreshNativeCoreUpdate();refreshAppUpdate()}});window.setInterval(()=>{if(!document.hidden&&connection.connected)syncUnifiedUpdateStatus(true)},4000)}
init();

async function loadFocus(){try{const d=await core('GET','/api/workspace');renderFocus(d)}catch(e){toast(e.message)}}
function renderFocus(data){const online=document.getElementById('focusOnline'),offline=document.getElementById('focusOffline');if(!connection.connected){online.classList.add('hidden');offline.innerHTML=iconOffline('Fokus membutuhkan Core','Hubungkan Furina Lite di Termux untuk menyimpan rencana bersama.');return}offline.innerHTML='';online.classList.remove('hidden');const rows=Array.isArray(data?.focus)?data.focus:[];document.getElementById('focusRows').innerHTML=rows.length?rows.map(x=>{const due=Number(x.due_at||0);const when=due?new Date(due*1000).toLocaleString('id-ID',{dateStyle:'medium',timeStyle:'short'}):'tanpa waktu';return `<div class="row"><div class="rowmain"><div class="rowtitle">${esc(x.text)}</div><div class="rowdesc">${esc(when)}</div></div><button class="btn" onclick="finishFocus(${Number(x.id)})">Selesai</button></div>`}).join(''):'<div class="empty">Belum ada Fokus aktif.</div>'}
async function addFocus(){const text=await askText('Tambah Fokus','Apa yang ingin kamu lanjutkan?',{multiline:true});if(!text?.trim())return;const when=await askText('Waktu (opsional)','Contoh: besok sore atau 24 Agustus 19:00');try{const d=await core('POST','/api/focus',{action:'add',text:text.trim(),when:(when||'').trim()});renderFocus(d);toast('Fokus disimpan di Furina Lite dan FurinaHub.')}catch(e){toast(e.message)}}
async function finishFocus(id){try{const d=await core('POST','/api/focus',{action:'done',id});renderFocus(d);toast('Fokus diselesaikan.')}catch(e){toast(e.message)}}
async function loadWorkspaceExtras(){if(!connection.connected)return;try{const d=await core('GET','/api/workspace');renderResponseProfiles(d.profile);const inbox=Array.isArray(d.memory_inbox)?d.memory_inbox:[];const el=document.getElementById('memoryInboxRows');if(el)el.innerHTML=inbox.length?inbox.map(x=>`<div class="row"><div class="rowmain"><div class="rowtitle">${esc(x.text)}</div><div class="rowdesc">Perlu ditinjau</div></div><button class="btn primary" onclick="decideInbox(${Number(x.id)},'accept')">Terima</button><button class="btn" onclick="decideInbox(${Number(x.id)},'reject')">Tolak</button></div>`).join(''):'<div class="empty">Tidak ada usulan baru.</div>'}catch(e){}}
function renderResponseProfiles(profile){const el=document.getElementById('responseProfiles');if(!el||!profile)return;el.innerHTML=(profile.profiles||[]).map(x=>`<button class="${x.id===profile.current?'on':''}" onclick="setResponseProfile('${esc(x.id)}')">${esc(x.label)}</button>`).join('')}
async function setResponseProfile(profile){try{const data=await core('POST','/api/profile',{profile});renderResponseProfiles(data);toast('Profil respons disimpan untuk Furina Lite dan FurinaHub.')}catch(e){toast(e.message)}}
