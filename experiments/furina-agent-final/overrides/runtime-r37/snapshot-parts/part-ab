        if ("message".equals(normalizedRole) && bestScore < 0 && count != 1) return null;
        if ("search".equals(normalizedRole) && bestScore < 40 && count != 1) return null;
        if (normalizedRole.isEmpty() && count != 1 && (best == null || !best.isFocused())) return null;
        return best;
