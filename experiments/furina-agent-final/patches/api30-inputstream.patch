+    private byte[] readExact(InputStream in, int len) throws Exception {
+        if (len == 0) return new byte[0];
+        byte[] out = new byte[len];
+        int offset = 0;
+        while (offset < len) {
+            int read = in.read(out, offset, len - offset);
+            if (read < 0) return null;
+            if (read == 0) continue;
+            offset += read;
+        }
+        return out;
+    }
