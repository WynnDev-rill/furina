+    private boolean imeAction(int id) {
+        AccessibilityNodeInfo n = nodeByIndex(id);
+        if (n == null || !n.isEditable() || Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return false;
+        if (!n.isFocused()) {
+            n.performAction(AccessibilityNodeInfo.ACTION_FOCUS);
+            n = nodeByIndex(id);
+            if (n == null) return false;
+        }
+        return n.performAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_IME_ENTER.getId());
+    }
