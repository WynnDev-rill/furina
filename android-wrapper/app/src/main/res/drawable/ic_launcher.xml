<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08111F" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <bitmap
            android:src="@drawable/furina_icon_source"
            android:gravity="fill"
            android:antialias="true"
            android:filter="true" />
    </item>
</layer-list>
