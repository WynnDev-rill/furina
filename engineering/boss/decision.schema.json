{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furina.local/engineering/boss/decision.schema.json",
  "title": "Furina Boss Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "pullRequest",
    "headSha",
    "engineerCycleId",
    "reviewCycleId",
    "bossCycleId",
    "reviewedHeadSha",
    "evidenceLevel",
    "autonomyClass",
    "productValue",
    "regressionRisk",
    "complexityCost",
    "confidence",
    "reason",
    "requiredNextAction",
    "decidedAt"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE_MERGE",
        "REJECT_CLOSE",
        "REQUEST_REVISION",
        "BLOCKED_HUMAN"
      ]
    },
    "pullRequest": {
      "type": "integer",
      "minimum": 1
    },
    "headSha": {
      "type": "string",
      "minLength": 7,
      "maxLength": 40,
      "pattern": "^[0-9a-fA-F]+$"
    },
    "engineerCycleId": {
      "type": "string",
      "minLength": 1
    },
    "reviewCycleId": {
      "type": "string",
      "minLength": 1
    },
    "bossCycleId": {
      "type": "string",
      "minLength": 1
    },
    "reviewedHeadSha": {
      "type": "string",
      "minLength": 7,
      "maxLength": 40,
      "pattern": "^[0-9a-fA-F]+$"
    },
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "STATIC",
        "CI",
        "BEHAVIORAL",
        "DEVICE"
      ]
    },
    "autonomyClass": {
      "type": "string",
      "enum": [
        "GREEN",
        "YELLOW",
        "RED"
      ]
    },
    "productValue": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "regressionRisk": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "complexityCost": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },
    "requiredNextAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
